@model ErrorViewModel
@{
    Layout = null;
    var requestId = Model?.RequestId;
    var detail = ViewBag.ErrorDetail as string ?? TempData["error"] as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Error | First Registrars</title>
</head>
<body style="font-family: system-ui, sans-serif; max-width: 720px; margin: 4rem auto; padding: 0 1.5rem;">
    <h1>Something went wrong</h1>
    <p>Your request could not be completed.</p>
    @if (!string.IsNullOrWhiteSpace(detail))
    {
        <p style="color:#b42318;"><strong>@detail</strong></p>
    }
    @if (!string.IsNullOrEmpty(requestId))
    {
        <p>Request ID: <code>@requestId</code></p>
    }
    <p><a href="/">Return home</a> · <a href="/login">Sign in</a></p>
</body>
</html>
