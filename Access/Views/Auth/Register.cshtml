@model RegisterModel

@{
    Layout = "_AccLayout";
    ViewData["Title"] = "Register";
}

<div class="d-lg-none text-center p-5 pt-10">
    <a href="~/" class="mb-15">
        <img alt="Logo" src="~/img/logos/logo.png" class="h-80px" />
    </a>
</div>

<div class="d-flex flex-column flex-lg-row flex-column-fluid stepper stepper-pills stepper-column" id="signup_stepper">
    <div class="d-none d-lg-flex flex-column flex-lg-row-auto w-xl-500px bg-lighten shadow-sm">
        <div class="d-flex flex-column position-xl-fixed top-0 bottom-0 w-xl-500px scroll-y">
            <div class="d-flex flex-row-fluid flex-column flex-center p-10 pt-lg-20">
                <input id="hd_checkemailurl" type="hidden" value="@Model.CheckEmailUrl" />
                <input id="hd_generatevalidateemailurl" type="hidden" value="@Model.GenerateValidateEmailUrl" />
                <input id="hd_validateemailurl" type="hidden" value="@Model.ValidateEmailUrl" />
                <a asp-controller="Home" asp-action="Index" class="mb-10 mb-lg-20"> <img alt="Logo" src="~/img/logos/logo.png" class="h-80px" /> </a>
                <div class="stepper-nav">
                    <div class="stepper-item current" data-kt-stepper-element="nav">
                        <div class="stepper-line w-40px"></div>
                        <div class="stepper-icon w-40px h-40px">
                            <i class="stepper-check fas fa-check"></i>
                            <span class="stepper-number">1</span>
                        </div>
                        <div class="stepper-label">
                            <h3 class="stepper-title">Account Type</h3>
                            <div class="stepper-desc fw-bold">Choose Your Account Type</div>
                        </div>
                    </div>
                    <div class="stepper-item" data-kt-stepper-element="nav">
                        <div class="stepper-line w-40px"></div>
                        <div class="stepper-icon w-40px h-40px">
                            <i class="stepper-check fas fa-check"></i>
                            <span class="stepper-number">2</span>
                        </div>
                        <div class="stepper-label">
                            <h3 class="stepper-title">Basic Information</h3>
                            <div class="stepper-desc fw-bold">Setup Your Account Settings</div>
                        </div>
                    </div>
                    <div class="stepper-item" data-kt-stepper-element="nav">
                        <div class="stepper-line w-40px"></div>
                        <div class="stepper-icon w-40px h-40px">
                            <i class="stepper-check fas fa-check"></i>
                            <span class="stepper-number">3</span>
                        </div>
                        <div class="stepper-label">
                            <h3 class="stepper-title">Address Information</h3>
                            <div class="stepper-desc fw-bold">Your Business Related Info</div>
                        </div>
                    </div>
                    <div class="stepper-item" data-kt-stepper-element="nav">
                        <div class="stepper-line w-40px"></div>
                        <div class="stepper-icon w-40px h-40px">
                            <i class="stepper-check fas fa-check"></i>
                            <span class="stepper-number">4</span>
                        </div>
                        <div class="stepper-label">
                            <h3 class="stepper-title">Validate Account</h3>
                            <div class="stepper-desc fw-bold">Set Your Payment Methods</div>
                        </div>
                    </div>
                    <div class="stepper-item" data-kt-stepper-element="nav">
                        <div class="stepper-line w-40px"></div>
                        <div class="stepper-icon w-40px h-40px">
                            <i class="stepper-check fas fa-check"></i>
                            <span class="stepper-number">5</span>
                        </div>
                        <div class="stepper-label">
                            <h3 class="stepper-title">Finalize</h3>
                            <div class="stepper-desc fw-bold">Review &amp; choose password</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="d-flex flex-row-auto bgi-no-repeat bgi-position-x-center bgi-size-contain bgi-position-y-bottom min-h-150px min-h-lg-300px" style="background-image: url(assets/media/illustrations/coding.png)"></div>
        </div>
    </div>
    <div class="d-flex flex-column flex-lg-row-fluid py-10">
        <div class="d-flex flex-center flex-column flex-column-fluid">
            <div class="w-lg-850px p-10 p-lg-15 mx-auto">

                <div class="current" data-kt-stepper-element="content">
                    <div class="w-100">
                        <form class="my-auto" id="form_type">
                            <div class="pb-10 pb-lg-15">
                                <h2 class="fw-bolder d-flex align-items-center text-dark">
                                    Choose Account Type
                                    <i class="fas fa-exclamation-circle ms-2 fs-7" data-bs-toggle="tooltip" title="Billing is issued based on your selected account type"></i>
                                </h2>
                                <div class="text-muted fw-bold fs-6">
                                    If you already have an account, please
                                    <a asp-action="Login" class="link-primary fw-bolder">Sign In</a>.
                                </div>
                            </div>
                            <div class="fv-row">
                                <div class="row">
                                    <div class="col-sm-6">
                                        <input type="radio" class="btn-check" name="Type" value="@UserType.Shareholder" id="form_signup_shareholder" required />
                                        <label class="btn btn-outline btn-outline-dashed btn-outline-default p-7 d-flex align-items-center mb-10" for="form_signup_shareholder"> <span class="svg-icon svg-icon-3x me-5"> <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"> <path d="M17 6C17 8.76142 14.7614 11 12 11C9.23858 11 7 8.76142 7 6C7 3.23858 9.23858 1 12 1C14.7614 1 17 3.23858 17 6Z" fill="#121319" /> <path opacity="0.25" fill-rule="evenodd" clip-rule="evenodd" d="M18.818 14.1248C18.2016 13.4101 17.1428 13.4469 16.3149 13.9001C15.0338 14.6013 13.5635 15 12 15C10.4365 15 8.96618 14.6013 7.68505 13.9001C6.85717 13.4469 5.79841 13.4101 5.182 14.1248C3.82222 15.7014 3 17.7547 3 20V21C3 22.1045 3.89543 23 5 23H19C20.1046 23 21 22.1045 21 21V20C21 17.7547 20.1778 15.7014 18.818 14.1248Z" fill="#191213" /> </svg> </span> <span class="d-block fw-bold text-start"> <span class="text-dark fw-bolder d-block fs-4 mb-2">Shareholer Account</span> <span class="text-muted fw-bold fs-6">If you need more info, please check it out</span> </span> </label>
                                    </div>
                                    <div class="col-sm-6">
                                        <input type="radio" class="btn-check" name="Type" value="@UserType.StockBroker" id="form_signup_stockbroker" required />
                                        <label class="btn btn-outline btn-outline-dashed btn-outline-default p-7 d-flex align-items-center" for="form_signup_stockbroker"> <span class="svg-icon svg-icon-3x me-5"> <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"> <path opacity="0.25" d="M2 10C2 8.34315 3.34315 7 5 7H19C20.6569 7 22 8.34315 22 10V19C22 20.6569 20.6569 22 19 22H5C3.34315 22 2 20.6569 2 19V10Z" fill="#12131A" /> <path fill-rule="evenodd" clip-rule="evenodd" d="M9 4C8.44772 4 8 4.44772 8 5V8C8 8.55228 7.55228 9 7 9C6.44772 9 6 8.55228 6 8V5C6 3.34315 7.34315 2 9 2H15C16.6569 2 18 3.34315 18 5V8C18 8.55228 17.5523 9 17 9C16.4477 9 16 8.55228 16 8V5C16 4.44772 15.5523 4 15 4H9Z" fill="#12131A" /> </svg> </span> <span class="d-block fw-bold text-start"> <span class="text-dark fw-bolder d-block fs-4 mb-2">Stock Broker Account</span> <span class="text-muted fw-bold fs-6">Create corporate account to mane users</span> </span> </label>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex flex-stack pt-15">
                                <div class="mr-2">
                                </div>
                                <div>
                                    <button type="submit" class="btn btn-lg btn-primary">Continue <span class="svg-icon svg-icon-4 ms-1"> <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1"> <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"> <polygon points="0 0 24 0 24 24 0 24" /> <rect fill="#000000" opacity="0.5" transform="translate(8.500000, 12.000000) rotate(-90.000000) translate(-8.500000, -12.000000)" x="7.5" y="7.5" width="2" height="9" rx="1" /> <path d="M9.70710318,15.7071045 C9.31657888,16.0976288 8.68341391,16.0976288 8.29288961,15.7071045 C7.90236532,15.3165802 7.90236532,14.6834152 8.29288961,14.2928909 L14.2928896,8.29289093 C14.6714686,7.914312 15.281055,7.90106637 15.675721,8.26284357 L21.675721,13.7628436 C22.08284,14.136036 22.1103429,14.7686034 21.7371505,15.1757223 C21.3639581,15.5828413 20.7313908,15.6103443 20.3242718,15.2371519 L15.0300721,10.3841355 L9.70710318,15.7071045 Z" fill="#000000" fill-rule="nonzero" transform="translate(14.999999, 11.999997) scale(1, -1) rotate(90.000000) translate(-14.999999, -11.999997)" /> </g> </svg> </span> </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="" data-kt-stepper-element="content">
                    <div class="w-100">
                        <form class="my-auto pb-5" id="form_basic">

                            <div class="pb-10 pb-lg-15">
                                <h2 class="fw-bolder text-dark">Basic Information</h2>
                                <div class="text-muted fw-bold fs-6">
                                    If you already have an account, please
                                    <a asp-action="Login" class="link-primary fw-bolder">Sign In</a>.
                                </div>
                                <div class="text-gray-800 fw-bold fs-6 mt-3">
                                    Kindly use the correct names used in purchasing your shares in filling this form.
                                </div>
                            </div>

                            <div class="row mb-10 fv-row">
                                <div class="col-6">
                                    <label class="form-label mb-3">Surname</label>
                                    <input type="text" class="form-control form-control-lg form-control-solid" asp-for="LastName" placeholder="Wilson" required />
                                </div>
                                <div class="col-6">
                                    <label class="form-label mb-3">Other names</label>
                                    <input type="text" class="form-control form-control-lg form-control-solid" asp-for="FirstName" placeholder="Adebola" required />
                                </div>
                            </div>

                            <div class="row mb-10 fv-row">
                                <div class="col-6">
                                    <label class="form-label mb-3">Email Address</label>
                                    <input type="text" class="form-control form-control-lg form-control-solid" asp-for="Email" placeholder="ex: user@email.com" required />
                                </div>
                                <div class="col-6">
                                    <label class="form-label mb-3">Primary Phone</label>
                                    <input type="text" class="form-control form-control-lg form-control-solid" asp-for="MobileNo" placeholder="ex: +234-801-2345678" required />
                                </div>
                            </div>

                            <div class="row mb-10 fv-row">
                                <div class="col-6">
                                    <label class="form-label mb-3">Secondary Phone</label>
                                    <input type="text" class="form-control form-control-lg form-control-solid" asp-for="SecondaryPhone" placeholder="ex: +234-801-2345678" />
                                </div>
                            </div>

                            <div class="mb-10" id="dv_clearing">
                                <label class="form-label mb-2">Register, Clearing House Number and Share Account Number</label>
                                <div class="text-muted fw-bold fs-7 mb-4">
                                    Select a register and add a Clearing House Number or Share Account Number. You can add more than one. At least one Clearing House Number or Share Account Number is required.
                                </div>
                                <div class="bg-light-primary rounded p-4 mb-5">
                                    <div class="fw-bold text-gray-800 mb-2">If you do not know your Clearing House Number or Share Account Number, contact us:</div>
                                    <div class="text-gray-700 fs-7 mb-1">
                                        Phone:
                                        <a href="tel:09154123719" class="fw-bolder">09154123719</a>,
                                        <a href="tel:09154123720" class="fw-bolder">09154123720</a>,
                                        <a href="tel:09154123721" class="fw-bolder">09154123721</a>,
                                        <a href="tel:09154123722" class="fw-bolder">09154123722</a>
                                    </div>
                                    <div class="text-gray-700 fs-7">
                                        Email:
                                        <a href="mailto:info@firstregistrarsnigeria.com" class="fw-bolder">info@firstregistrarsnigeria.com</a>
                                    </div>
                                </div>
                                <div id="signup_accounts">
                                    <div class="signup-account-row border rounded p-4 mb-4">
                                        <div class="row g-4">
                                            <div class="col-12">
                                                <label class="form-label mb-2">Register</label>
                                                <select class="form-select form-control-lg form-control-solid signup-register">
                                                    <option value="">Select register...</option>
                                                    @foreach (var reg in Model.Registers ?? new List<Register>())
                                                    {
                                                        <option value="@reg.Id">@reg.Name</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-12">
                                                <div class="row g-4 align-items-end">
                                                    <div class="col">
                                                        <label class="form-label mb-2">Clearing House Number</label>
                                                        <input type="text" class="form-control form-control-lg form-control-solid signup-chn" placeholder="e.g. CH90233490" />
                                                    </div>
                                                    <div class="col-auto pb-3">
                                                        <span class="fw-bolder text-muted fs-5">or</span>
                                                    </div>
                                                    <div class="col">
                                                        <label class="form-label mb-2">Share Account Number</label>
                                                        <input type="text" class="form-control form-control-lg form-control-solid signup-accno" placeholder="e.g. 149380397" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="text-end mt-3">
                                            <button type="button" class="btn btn-sm btn-light-danger signup-remove-account" style="display:none;">Remove</button>
                                        </div>
                                    </div>
                                </div>
                                <button type="button" id="bt_add_signup_account" class="btn btn-light-primary">
                                    Add another Clearing House Number / Share Account Number
                                </button>
                            </div>

                            <div class="d-flex flex-stack pt-15">
                                <div class="mr-2">
                                    <button type="button" id="bt_cancel_basic" class="btn btn-lg btn-light-primary me-3"> <span class="svg-icon svg-icon-4 me-1"> <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1"> <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"> <polygon points="0 0 24 0 24 24 0 24" /> <rect fill="#000000" opacity="0.3" transform="translate(15.000000, 12.000000) scale(-1, 1) rotate(-90.000000) translate(-15.000000, -12.000000)" x="14" y="7" width="2" height="10" rx="1" /> <path d="M3.7071045,15.7071045 C3.3165802,16.0976288 2.68341522,16.0976288 2.29289093,15.7071045 C1.90236664,15.3165802 1.90236664,14.6834152 2.29289093,14.2928909 L8.29289093,8.29289093 C8.67146987,7.914312 9.28105631,7.90106637 9.67572234,8.26284357 L15.6757223,13.7628436 C16.0828413,14.136036 16.1103443,14.7686034 15.7371519,15.1757223 C15.3639594,15.5828413 14.7313921,15.6103443 14.3242731,15.2371519 L9.03007346,10.3841355 L3.7071045,15.7071045 Z" fill="#000000" fill-rule="nonzero" transform="translate(9.000001, 11.999997) scale(-1, -1) rotate(90.000000) translate(-9.000001, -11.999997)" /> </g> </svg> </span> Previous</button>
                                </div>
                                <div>
                                    <button type="submit" id="bt_submit_basic" class="btn btn-lg btn-primary">
                                        <span class="indicator-label">
                                            Continue <span class="svg-icon svg-icon-4 ms-1"> <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1"> <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"> <polygon points="0 0 24 0 24 24 0 24" /> <rect fill="#000000" opacity="0.5" transform="translate(8.500000, 12.000000) rotate(-90.000000) translate(-8.500000, -12.000000)" x="7.5" y="7.5" width="2" height="9" rx="1" /> <path d="M9.70710318,15.7071045 C9.31657888,16.0976288 8.68341391,16.0976288 8.29288961,15.7071045 C7.90236532,15.3165802 7.90236532,14.6834152 8.29288961,14.2928909 L14.2928896,8.29289093 C14.6714686,7.914312 15.281055,7.90106637 15.675721,8.26284357 L21.675721,13.7628436 C22.08284,14.136036 22.1103429,14.7686034 21.7371505,15.1757223 C21.3639581,15.5828413 20.7313908,15.6103443 20.3242718,15.2371519 L15.0300721,10.3841355 L9.70710318,15.7071045 Z" fill="#000000" fill-rule="nonzero" transform="translate(14.999999, 11.999997) scale(1, -1) rotate(90.000000) translate(-14.999999, -11.999997)" /> </g> </svg> </span>
                                        </span>
                                        <span class="indicator-progress">
                                            Please wait...
                                            <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                                        </span>
                                    </button>
                                </div>
                            </div>

                        </form>
                    </div>
                </div>

                <div class="" data-kt-stepper-element="content">
                    <div class="w-100">
                        <form class="my-auto pb-5" id="form_address">

                            <div class="pb-10 pb-lg-12">
                                <h2 class="fw-bolder text-dark">Address Information</h2>
                                <div class="text-muted fw-bold fs-6">
                                    If you already have an account, please
                                    <a asp-action="Login" class="link-primary fw-bolder">Sign In</a>.
                                </div>
                            </div>

                            <div class="mb-10 fv-row">
                                <label class="form-label mb-3">Street Address</label>
                                <input type="text" class="form-control form-control-lg form-control-solid" asp-for="Street" placeholder="ex: 14, Clearwox Drive" required />
                            </div>

                            <div class="row mb-10 fv-row">
                                <div class="col-6">
                                    <label class="form-label mb-3">City</label>
                                    <input type="text" class="form-control form-control-lg form-control-solid" asp-for="City" placeholder="ex: Ikeja" required />
                                </div>
                                <div class="col-6">
                                    <label class="form-label mb-3">State</label>
                                    <input type="text" class="form-control form-control-lg form-control-solid" asp-for="State" placeholder="ex: Lagos" required />
                                </div>
                            </div>

                            <div class="row mb-10 fv-row">
                                <div class="col-6">
                                    <label class="form-label mb-3">Post Code</label>
                                    <input type="text" class="form-control form-control-lg form-control-solid" asp-for="PostCode" placeholder="ex: 101120" required />
                                </div>
                                <div class="col-6">
                                    <label class="form-label mb-3">Country</label>
                                    <input type="text" class="form-control form-control-lg form-control-solid" asp-for="Country" placeholder="ex: Nigeria" required />
                                </div>
                            </div>

                            <div class="d-flex flex-stack pt-15">
                                <div class="mr-2">
                                    <button type="button" id="bt_cancel_address" class="btn btn-lg btn-light-primary me-3"> <span class="svg-icon svg-icon-4 me-1"> <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1"> <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"> <polygon points="0 0 24 0 24 24 0 24" /> <rect fill="#000000" opacity="0.3" transform="translate(15.000000, 12.000000) scale(-1, 1) rotate(-90.000000) translate(-15.000000, -12.000000)" x="14" y="7" width="2" height="10" rx="1" /> <path d="M3.7071045,15.7071045 C3.3165802,16.0976288 2.68341522,16.0976288 2.29289093,15.7071045 C1.90236664,15.3165802 1.90236664,14.6834152 2.29289093,14.2928909 L8.29289093,8.29289093 C8.67146987,7.914312 9.28105631,7.90106637 9.67572234,8.26284357 L15.6757223,13.7628436 C16.0828413,14.136036 16.1103443,14.7686034 15.7371519,15.1757223 C15.3639594,15.5828413 14.7313921,15.6103443 14.3242731,15.2371519 L9.03007346,10.3841355 L3.7071045,15.7071045 Z" fill="#000000" fill-rule="nonzero" transform="translate(9.000001, 11.999997) scale(-1, -1) rotate(90.000000) translate(-9.000001, -11.999997)" /> </g> </svg> </span> Previous</button>
                                </div>
                                <div>
                                    <button type="submit" class="btn btn-lg btn-primary">Continue <span class="svg-icon svg-icon-4 ms-1"> <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1"> <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"> <polygon points="0 0 24 0 24 24 0 24" /> <rect fill="#000000" opacity="0.5" transform="translate(8.500000, 12.000000) rotate(-90.000000) translate(-8.500000, -12.000000)" x="7.5" y="7.5" width="2" height="9" rx="1" /> <path d="M9.70710318,15.7071045 C9.31657888,16.0976288 8.68341391,16.0976288 8.29288961,15.7071045 C7.90236532,15.3165802 7.90236532,14.6834152 8.29288961,14.2928909 L14.2928896,8.29289093 C14.6714686,7.914312 15.281055,7.90106637 15.675721,8.26284357 L21.675721,13.7628436 C22.08284,14.136036 22.1103429,14.7686034 21.7371505,15.1757223 C21.3639581,15.5828413 20.7313908,15.6103443 20.3242718,15.2371519 L15.0300721,10.3841355 L9.70710318,15.7071045 Z" fill="#000000" fill-rule="nonzero" transform="translate(14.999999, 11.999997) scale(1, -1) rotate(90.000000) translate(-14.999999, -11.999997)" /> </g> </svg> </span> </button>
                                </div>
                            </div>

                        </form>
                    </div>
                </div>

                <div class="" data-kt-stepper-element="content">
                    <div class="w-100">
                        <form class="my-auto pb-5" id="form_validate">

                            <div class="pb-10 pb-lg-15">
                                <h2 class="fw-bolder text-dark">Validate Account</h2>
                                <div class="text-muted fw-bold fs-6">
                                    If you already have an account, please
                                    <a asp-action="Login" class="link-primary fw-bolder">Sign In</a>.
                                </div>
                            </div>

                            <div class="mb-10 fv-row">
                                <label class="form-label mb-3 fw-bolder text-dark">Validate Email - <a id="bt_resend_link" href="javascrpt:;">Resend Code</a></label>
                                <div class="row">
                                    <div class="col-9 col-md-6">
                                        <div id="tx_email_code_wrp">
                                            <input type="text" id="tx_email_code" class="form-control form-control-lg form-control-solid" placeholder="Enter email code" required />
                                        </div>
                                    </div>
                                    <div class="col-3">
                                        <a href="javascript:void(0);" id="bt_validate_email" class="btn btn-primary font-weight-bold font-size-h3 px-12 py-3 h-100 fs-3">Validate</a>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-10">
                                <label class="form-label mb-4 fw-bolder text-dark">Upload documents</label>
                                <div class="row g-5">
                                    <div class="col-md-4">
                                        <div class="signup-doc-card h-100">
                                            <div class="fw-bolder text-dark mb-4">1. Profile picture <span class="text-danger">*</span></div>
                                            <input type="file" id="signup_file_photo" class="d-none" accept="image/*" data-doc="photo" />
                                            <label for="signup_file_photo" class="btn btn-primary">Choose file</label>
                                            <div class="mt-3">
                                                <a href="javascript:;" class="signup-take-photo link-primary fw-bold" data-doc="photo">Take photo</a>
                                            </div>
                                            <div class="text-muted fs-8 mt-3 signup-doc-status" id="signup_status_photo"></div>
                                            <div class="signup-doc-preview mt-3" id="signup_preview_photo_wrp" style="display:none;">
                                                <img id="signup_preview_photo" alt="Profile picture" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="signup-doc-card h-100">
                                            <div class="fw-bolder text-dark mb-4">2. Passport / NIN <span class="text-danger">*</span></div>
                                            <input type="file" id="signup_file_passport" class="d-none" accept="image/*,.pdf,application/pdf" data-doc="passport" />
                                            <label for="signup_file_passport" class="btn btn-primary">Choose file</label>
                                            <div class="mt-3">
                                                <a href="javascript:;" class="signup-take-photo link-primary fw-bold" data-doc="passport">Take photo</a>
                                            </div>
                                            <div class="text-muted fs-8 mt-3 signup-doc-status" id="signup_status_passport"></div>
                                            <div class="signup-doc-preview mt-3" id="signup_preview_passport_wrp" style="display:none;">
                                                <img id="signup_preview_passport" alt="Passport / NIN" />
                                                <div class="text-muted fs-8 mt-2" id="signup_preview_passport_file" style="display:none;">PDF selected</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="signup-doc-card h-100">
                                            <div class="fw-bolder text-dark mb-4">3. Signature <span class="text-danger">*</span></div>
                                            <input type="file" id="signup_file_signature" class="d-none" accept="image/*" data-doc="signature" />
                                            <label for="signup_file_signature" class="btn btn-primary">Choose file</label>
                                            <div class="mt-3">
                                                <a href="javascript:;" class="signup-take-photo link-primary fw-bold" data-doc="signature">Take photo</a>
                                            </div>
                                            <div class="text-muted fs-8 mt-3 signup-doc-status" id="signup_status_signature"></div>
                                            <div class="signup-doc-preview mt-3" id="signup_preview_signature_wrp" style="display:none;">
                                                <img id="signup_preview_signature" alt="Signature" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="text-muted fs-7 mt-5">All three are required. You can choose a file or take a live photo with your phone, tablet or laptop camera.</div>
                            </div>

                            <div class="d-flex flex-stack pt-15">
                                <div class="mr-2">
                                    <button type="button" id="bt_cancel_validate" class="btn btn-lg btn-light-primary me-3"> <span class="svg-icon svg-icon-4 me-1"> <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1"> <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"> <polygon points="0 0 24 0 24 24 0 24" /> <rect fill="#000000" opacity="0.3" transform="translate(15.000000, 12.000000) scale(-1, 1) rotate(-90.000000) translate(-15.000000, -12.000000)" x="14" y="7" width="2" height="10" rx="1" /> <path d="M3.7071045,15.7071045 C3.3165802,16.0976288 2.68341522,16.0976288 2.29289093,15.7071045 C1.90236664,15.3165802 1.90236664,14.6834152 2.29289093,14.2928909 L8.29289093,8.29289093 C8.67146987,7.914312 9.28105631,7.90106637 9.67572234,8.26284357 L15.6757223,13.7628436 C16.0828413,14.136036 16.1103443,14.7686034 15.7371519,15.1757223 C15.3639594,15.5828413 14.7313921,15.6103443 14.3242731,15.2371519 L9.03007346,10.3841355 L3.7071045,15.7071045 Z" fill="#000000" fill-rule="nonzero" transform="translate(9.000001, 11.999997) scale(-1, -1) rotate(90.000000) translate(-9.000001, -11.999997)" /> </g> </svg> </span> Previous</button>
                                </div>
                                <div>
                                    <button type="submit" id="btn-submit-validation" class="btn btn-lg btn-primary" disabled title="Validate email and upload all three documents before continuing">Continue <span class="svg-icon svg-icon-4 ms-1"> <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1"> <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"> <polygon points="0 0 24 0 24 24 0 24" /> <rect fill="#000000" opacity="0.5" transform="translate(8.500000, 12.000000) rotate(-90.000000) translate(-8.500000, -12.000000)" x="7.5" y="7.5" width="2" height="9" rx="1" /> <path d="M9.70710318,15.7071045 C9.31657888,16.0976288 8.68341391,16.0976288 8.29288961,15.7071045 C7.90236532,15.3165802 7.90236532,14.6834152 8.29288961,14.2928909 L14.2928896,8.29289093 C14.6714686,7.914312 15.281055,7.90106637 15.675721,8.26284357 L21.675721,13.7628436 C22.08284,14.136036 22.1103429,14.7686034 21.7371505,15.1757223 C21.3639581,15.5828413 20.7313908,15.6103443 20.3242718,15.2371519 L15.0300721,10.3841355 L9.70710318,15.7071045 Z" fill="#000000" fill-rule="nonzero" transform="translate(14.999999, 11.999997) scale(1, -1) rotate(90.000000) translate(-14.999999, -11.999997)" /> </g> </svg> </span> </button>
                                </div>
                            </div>

                        </form>
                    </div>
                </div>

                <div class="" data-kt-stepper-element="content">
                    <div class="w-100">
                        <form class="my-auto pb-5" id="form_final" method="post">

                            <div class="pb-8 pb-lg-10">
                                <h2 class="fw-bolder text-dark">Review &amp; Choose your Password!</h2>
                                <div class="text-muted fw-bold fs-6">
                                    If you already have an account, please
                                    <a asp-action="Login" class="link-primary fw-bolder">Sign In</a>.
                                </div>
                            </div>

                            <div class="mb-0">
                                <div class="fs-6 text-gray-600 mb-10">
                                    Please choose a strong password to secure your account.
                                </div>

                                <div class="row">
                                    <div class="col-sm-6">
                                        <h4 class="fw-bolder">Basic Information:</h4>
                                        <div class="text-dark-50 font-weight-bold line-height-lg mb-8">
                                            <div>
                                                <span id="sp-fname"></span>
                                                <span id="sp-lname"></span>
                                                <span id="sp-clearing"></span>
                                            </div>
                                            <div>
                                                <span id="sp-phone"></span>,
                                                <span id="sp-home"></span>
                                            </div>
                                            <div>
                                                <span id="sp-email"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <h4 class="fw-bolder mb-3">Contact Information:</h4>
                                        <div class="text-dark-50 font-weight-bold line-height-lg mb-8">
                                            <div>
                                                <span id="sp-street"></span>
                                                <span id="sp-city"></span>
                                            </div>
                                            <div>
                                                <span id="sp-state"></span>
                                                <span id="sp-postcode"></span>
                                                <span id="sp-country"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <input type="hidden" asp-for="Type" />
                                <input type="hidden" asp-for="Email" />
                                <input type="hidden" asp-for="MobileNo" />
                                <input type="hidden" asp-for="Username" />
                                <input type="hidden" asp-for="Email" />
                                <input type="hidden" asp-for="MobileNo" />
                                <input type="hidden" asp-for="FirstName" />
                                <input type="hidden" asp-for="LastName" />
                                <input type="hidden" asp-for="SecondaryPhone" />
                                <input type="hidden" asp-for="Street" />
                                <input type="hidden" asp-for="City" />
                                <input type="hidden" asp-for="State" />
                                <input type="hidden" asp-for="Country" />
                                <input type="hidden" asp-for="PostCode" />
                                <input type="hidden" asp-for="EmailConfirmed" />
                                <input type="hidden" asp-for="ClearingNo" />
                                <input type="hidden" asp-for="Signature" id="Signature" />
                                <input type="hidden" asp-for="Photo" id="Photo" />
                                <input type="hidden" asp-for="Passport" id="Passport" />
                                <div id="signup_accounts_hidden"></div>

                            </div>

                            <div class="mb-10 fv-row">
                                <label class="form-label mb-3">Username</label>
                                <input type="text" class="form-control form-control-lg form-control-solid" asp-for="Username" placeholder="user@email.com" required readonly />
                            </div>

                            <div class="row mb-10 fv-row">
                                <div class="col-6">
                                    <label class="form-label mb-3">Password</label>
                                    <input type="password" class="form-control form-control-lg form-control-solid" asp-for="Password" placeholder="••••••••" required />
                                </div>
                                <div class="col-6">
                                    <label class="form-label mb-3">Confirm password</label>
                                    <input type="password" class="form-control form-control-lg form-control-solid" asp-for="RePassword" placeholder="••••••••" required />
                                </div>
                            </div>

                            <div class="d-flex flex-stack pt-15">
                                <div class="mr-2">
                                    <button type="button" id="bt_cancel_final" class="btn btn-lg btn-light-primary me-3"> <span class="svg-icon svg-icon-4 me-1"> <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1"> <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"> <polygon points="0 0 24 0 24 24 0 24" /> <rect fill="#000000" opacity="0.3" transform="translate(15.000000, 12.000000) scale(-1, 1) rotate(-90.000000) translate(-15.000000, -12.000000)" x="14" y="7" width="2" height="10" rx="1" /> <path d="M3.7071045,15.7071045 C3.3165802,16.0976288 2.68341522,16.0976288 2.29289093,15.7071045 C1.90236664,15.3165802 1.90236664,14.6834152 2.29289093,14.2928909 L8.29289093,8.29289093 C8.67146987,7.914312 9.28105631,7.90106637 9.67572234,8.26284357 L15.6757223,13.7628436 C16.0828413,14.136036 16.1103443,14.7686034 15.7371519,15.1757223 C15.3639594,15.5828413 14.7313921,15.6103443 14.3242731,15.2371519 L9.03007346,10.3841355 L3.7071045,15.7071045 Z" fill="#000000" fill-rule="nonzero" transform="translate(9.000001, 11.999997) scale(-1, -1) rotate(90.000000) translate(-9.000001, -11.999997)" /> </g> </svg> </span> Previous</button>
                                </div>
                                <div>
                                    @*<button type="submit" class="btn btn-lg btn-primary">Continue  </button>*@

                                    <button type="submit" class="btn btn-primary bt-submit">
                                        <span class="indicator-label">
                                            Submit
                                            <span class="svg-icon svg-icon-4 ms-1"> <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1"> <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"> <polygon points="0 0 24 0 24 24 0 24" /> <rect fill="#000000" opacity="0.5" transform="translate(8.500000, 12.000000) rotate(-90.000000) translate(-8.500000, -12.000000)" x="7.5" y="7.5" width="2" height="9" rx="1" /> <path d="M9.70710318,15.7071045 C9.31657888,16.0976288 8.68341391,16.0976288 8.29288961,15.7071045 C7.90236532,15.3165802 7.90236532,14.6834152 8.29288961,14.2928909 L14.2928896,8.29289093 C14.6714686,7.914312 15.281055,7.90106637 15.675721,8.26284357 L21.675721,13.7628436 C22.08284,14.136036 22.1103429,14.7686034 21.7371505,15.1757223 C21.3639581,15.5828413 20.7313908,15.6103443 20.3242718,15.2371519 L15.0300721,10.3841355 L9.70710318,15.7071045 Z" fill="#000000" fill-rule="nonzero" transform="translate(14.999999, 11.999997) scale(1, -1) rotate(90.000000) translate(-14.999999, -11.999997)" /> </g> </svg> </span>
                                        </span>
                                        <span class="indicator-progress">
                                            Please wait...
                                            <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                                        </span>
                                    </button>
                                </div>
                            </div>

                        </form>
                    </div>
                </div>

            </div>
        </div>
        <partial name="_Footer" />
    </div>
</div>

<div class="modal fade" id="signup_camera_modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="fw-bolder mb-0" id="signup_camera_title">Take photo</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <video id="signup_camera_video" autoplay playsinline muted style="width:100%; max-height:360px; background:#111; border-radius:8px;"></video>
                <canvas id="signup_camera_canvas" class="d-none"></canvas>
                <div class="text-muted fs-7 mt-3">Allow camera access, then capture the photo.</div>
            </div>
            <div class="modal-footer flex-center">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="signup_camera_capture" class="btn btn-primary">Capture</button>
            </div>
        </div>
    </div>
</div>

@section styles {
<style>
    /* Centered, 3x email-validation toast */
    #toast-container.toast-center-xl {
        top: 50% !important;
        right: auto !important;
        bottom: auto !important;
        left: 50% !important;
        transform: translate(-50%, -50%);
        width: auto !important;
        margin: 0 !important;
    }

    #toast-container.toast-center-xl > div {
        width: 900px !important;
        max-width: 92vw !important;
        padding: 45px 45px 45px 100px !important;
        font-size: 42px !important;
        line-height: 1.35 !important;
        opacity: 1 !important;
        background-size: 64px auto !important;
        background-position: 28px center !important;
        border-radius: 12px !important;
    }

    #toast-container.toast-center-xl > div .toast-message {
        font-size: 42px !important;
    }

    #toast-container.toast-center-xl > div .toast-close-button {
        font-size: 36px !important;
        right: 12px !important;
        top: 8px !important;
    }

    .signup-doc-card {
        border: 1px solid #e4e6ef;
        background: #f9f9fb;
        border-radius: 8px;
        padding: 1.5rem 1.25rem;
    }

    .signup-doc-preview img {
        width: 100%;
        max-width: 160px;
        height: 120px;
        object-fit: cover;
        border: 1px solid #e4e6ef;
        border-radius: 4px;
        background: #111;
    }
</style>
}

